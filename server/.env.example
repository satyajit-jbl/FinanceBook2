PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/finance_tracker
CLIENT_URL=http://localhost:3000

# Firebase Admin SDK (for Google OAuth verification)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# JWT (for local email/password auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-very-long-random-secret-here-at-least-64-chars
JWT_EXPIRES=7d
