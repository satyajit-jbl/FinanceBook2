                                                                                                                                                                                                                                                                                                                                                                                        # ── Production Environment (Vercel) ──────────────────────────────
# Set ALL of these as Environment Variables in the Vercel dashboard
# NEVER commit this file with real values

PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finance_tracker?retryWrites=true&w=majority
CLIENT_URL=https://YOUR-APP.netlify.app

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

JWT_SECRET=your-64-char-production-secret-never-share
JWT_EXPIRES=7d
